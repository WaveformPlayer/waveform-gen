{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "test/**"] },
  // Off for 2.0: reformatting is its own change, once a style is chosen
  // (src indents 4 spaces, tests use tabs).
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // 2.0 ships 2.2.0's exact code (the emitted JS is compared with
      // comments stripped). Every rule below is off because its fix would
      // change emitted code, or because it contradicts something deliberate.
      // Revisit them together after 2.0, each with its own tests.
      // Same policy as waveform-player's biome.jsonc.
      "style": {
        "noNonNullAssertion": "off", // deliberate: each `!` marks where the code relies on an earlier check
        "useTemplate": "off",
        "useExponentiationOperator": "off"
      },
      "suspicious": {
        "noExplicitAny": "off", // internal anys, to be tightened after 2.0
        "useIterableCallbackReturn": "off", // expression-bodied forEach callbacks; a block body is different code
        "noGlobalIsFinite": "off", // isFinite coerces, Number.isFinite does not: a behaviour change
        "noPrototypeBuiltins": "off",
        "noConfusingVoidType": "off",
        // waveform-gen only:
        "noGlobalIsNan": "off", // `parts.some(isNaN)`: isNaN coerces, Number.isNaN does not
        "noAssignInExpressions": "off" // parseFilename's `(m = a.match()) || (m = b.match())`
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "useParseIntRadix": "off" // adding a radix changes how "0x..." parses
      },
      "complexity": {
        "useOptionalChain": "off", // `a && a.b` and `a?.b` differ when a is 0 or ""
        "noThisInStatic": "off",
        "useLiteralKeys": "off",
        "useMathMinMax": "off" // waveform-gen: normalizePeaks' ternary skips a NaN peak, Math.max returns NaN
      }
    }
  }
}
