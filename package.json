{
  "name": "@arraypress/waveform-gen",
  "version": "3.1.0",
  "description": "Generate waveform peak data from audio files. CLI and library for pre-computing waveform data for WaveformPlayer, and sounds manifests for WaveformSounds.",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "bin": {
    "waveform-gen": "dist/bin/waveform-gen.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:cli": "node dist/bin/waveform-gen.js --help",
    "lint": "biome lint",
    "typecheck": "tsc -p .",
    "prepack": "npm run build"
  },
  "keywords": [
    "waveform",
    "audio",
    "peaks",
    "waveform-player",
    "mp3",
    "wav",
    "visualization",
    "cli",
    "generator"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveformPlayer/waveform-gen.git"
  },
  "homepage": "https://github.com/WaveformPlayer/waveform-gen",
  "bugs": {
    "url": "https://github.com/WaveformPlayer/waveform-gen/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "audio-decode": "^3.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
